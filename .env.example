# Chave da OpenAI (provedor do modelo abaixo). Nunca commitar a chave real.
OPENAI_API_KEY=

# Modelo do agent no formato provedor/modelo (model router do Mastra). O prefixo escolhe o provedor e a chave <PROVEDOR>_API_KEY.
NEXO_MODEL=openai/gpt-6-luna
# Modelo rápido reservado para classificações auxiliares (hoje não é usado: tipo/categoria são determinísticos)
NEXO_FAST_MODEL=openai/gpt-6-luna

# Segredo do token de sessão (HMAC). Obrigatório fora de desenvolvimento.
NEXO_AUTH_SECRET=troque-por-um-segredo-longo

# Arquivo SQLite (conversas, chamados, estado). Persiste entre reinícios.
NEXO_DB_PATH=./data/nexo.db

# Limite de mensagens do funcionário por conversa
NEXO_MESSAGE_LIMIT=30

# Simulação do sistema de chamados legado: probabilidade por chamada de abrir uma janela de indisponibilidade e duração dela
NEXO_TICKETS_OUTAGE_RATE=0.05
NEXO_TICKETS_OUTAGE_MS=2000

# Fuso do horário útil (minutos em relação ao UTC). -180 = Brasília
NEXO_BUSINESS_TZ_OFFSET_MINUTES=-180
